diff --git a/src/features/tasks/components/data-table-bulk-actions.test.tsx b/src/features/tasks/components/data-table-bulk-actions.test.tsx
new file mode 100644
index 0000000..132d511
--- /dev/null
+++ b/src/features/tasks/components/data-table-bulk-actions.test.tsx
@@ -0,0 +1,267 @@
+import { useState } from 'react'
+import {
+  type ColumnDef,
+  type RowSelectionState,
+  getCoreRowModel,
+  getFilteredRowModel,
+  getPaginationRowModel,
+  getSortedRowModel,
+  useReactTable,
+} from '@tanstack/react-table'
+import { toast } from 'sonner'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { render } from 'vitest-browser-react'
+import { userEvent } from 'vitest/browser'
+import { type Task } from '../data/schema'
+import { downloadTasksCsv } from '../lib/export-tasks'
+import { DataTableBulkActions } from './data-table-bulk-actions'
+
+vi.mock('../lib/export-tasks', () => ({ downloadTasksCsv: vi.fn() }))
+vi.mock('sonner', () => ({
+  toast: { success: vi.fn(), error: vi.fn(), promise: vi.fn() },
+}))
+
+const tasks: Task[] = [
+  {
+    id: 'TASK-Z',
+    title: 'Zulu',
+    status: 'todo',
+    label: 'feature',
+    priority: 'high',
+  },
+  {
+    id: 'TASK-D',
+    title: 'Delta',
+    status: 'done',
+    label: 'bug',
+    priority: 'low',
+  },
+  {
+    id: 'TASK-A',
+    title: 'Alpha',
+    status: 'todo',
+    label: 'documentation',
+    priority: 'medium',
+  },
+  {
+    id: 'TASK-B',
+    title: 'Bravo',
+    status: 'todo',
+    label: 'feature',
+    priority: 'low',
+  },
+]
+
+const columns: ColumnDef<Task>[] = [
+  { accessorKey: 'id' },
+  { accessorKey: 'title' },
+  { accessorKey: 'status', filterFn: 'equalsString' },
+]
+
+function TableHarness() {
+  const [rowSelection, setRowSelection] = useState<RowSelectionState>({})
+  // eslint-disable-next-line react-hooks/incompatible-library
+  const table = useReactTable({
+    data: tasks,
+    columns,
+    getRowId: (task) => task.id,
+    initialState: { pagination: { pageIndex: 0, pageSize: 2 } },
+    state: { rowSelection },
+    onRowSelectionChange: setRowSelection,
+    enableRowSelection: true,
+    getCoreRowModel: getCoreRowModel(),
+    getFilteredRowModel: getFilteredRowModel(),
+    getSortedRowModel: getSortedRowModel(),
+    getPaginationRowModel: getPaginationRowModel(),
+  })
+
+  return (
+    <>
+      <button
+        type='button'
+        onClick={() => {
+          table.setColumnFilters([{ id: 'status', value: 'todo' }])
+          table.setPageIndex(0)
+        }}
+      >
+        Show todo tasks
+      </button>
+      <button type='button' onClick={() => table.resetColumnFilters()}>
+        Clear filter
+      </button>
+      <button
+        type='button'
+        onClick={() => table.setSorting([{ id: 'title', desc: false }])}
+      >
+        Sort by title ascending
+      </button>
+      <div>
+        {table.getRowModel().rows.map((row) => (
+          <label key={row.id}>
+            <input
+              type='checkbox'
+              checked={row.getIsSelected()}
+              onChange={row.getToggleSelectedHandler()}
+            />
+            Select {row.original.id}
+          </label>
+        ))}
+      </div>
+      <button
+        type='button'
+        disabled={!table.getCanPreviousPage()}
+        onClick={() => table.previousPage()}
+      >
+        Previous page
+      </button>
+      <button
+        type='button'
+        disabled={!table.getCanNextPage()}
+        onClick={() => table.nextPage()}
+      >
+        Next page
+      </button>
+      <p data-testid='selected-task-ids'>
+        {Object.keys(rowSelection)
+          .filter((id) => rowSelection[id])
+          .sort()
+          .join(', ')}
+      </p>
+      <DataTableBulkActions table={table} />
+    </>
+  )
+}
+
+describe('DataTableBulkActions CSV export', () => {
+  beforeEach(() => vi.resetAllMocks())
+
+  it('does not offer export without a selection', async () => {
+    const { getByRole } = await render(<TableHarness />)
+
+    await expect
+      .element(getByRole('button', { name: 'Export tasks', exact: true }))
+      .not.toBeInTheDocument()
+    await expect.element(getByRole('toolbar')).not.toBeInTheDocument()
+    expect(downloadTasksCsv).not.toHaveBeenCalled()
+    expect(toast.success).not.toHaveBeenCalled()
+  })
+
+  it('exports selected tasks across pages in filtered sort order and keeps all selections', async () => {
+    const { getByRole, getByTestId } = await render(<TableHarness />)
+
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-Z' }))
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-D' }))
+    await userEvent.click(getByRole('button', { name: 'Next page' }))
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-A' }))
+    await userEvent.click(getByRole('button', { name: 'Show todo tasks' }))
+    await userEvent.click(
+      getByRole('button', { name: 'Sort by title ascending' })
+    )
+
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-A' }))
+      .toBeChecked()
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-B' }))
+      .not.toBeChecked()
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-Z' }))
+      .not.toBeInTheDocument()
+
+    await userEvent.click(
+      getByRole('button', { name: 'Export tasks', exact: true })
+    )
+
+    expect(downloadTasksCsv).toHaveBeenCalledExactlyOnceWith([
+      tasks[2],
+      tasks[0],
+    ])
+    expect(toast.success).toHaveBeenCalledOnce()
+    expect(toast.error).not.toHaveBeenCalled()
+    await expect
+      .element(getByTestId('selected-task-ids'))
+      .toHaveTextContent('TASK-A, TASK-D, TASK-Z')
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-A' }))
+      .toBeChecked()
+
+    await userEvent.click(getByRole('button', { name: 'Next page' }))
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-Z' }))
+      .toBeChecked()
+    await userEvent.click(getByRole('button', { name: 'Clear filter' }))
+    await expect
+      .element(getByRole('button', { name: 'Previous page' }))
+      .toBeDisabled()
+    await userEvent.click(getByRole('button', { name: 'Next page' }))
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-D' }))
+      .toBeChecked()
+  })
+
+  it('hides export when filters exclude every selected task without clearing selection', async () => {
+    const { getByRole, getByTestId } = await render(<TableHarness />)
+
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-D' }))
+    await userEvent.click(getByRole('button', { name: 'Show todo tasks' }))
+
+    await expect
+      .element(getByRole('button', { name: 'Export tasks', exact: true }))
+      .not.toBeInTheDocument()
+    await expect
+      .element(getByTestId('selected-task-ids'))
+      .toHaveTextContent('TASK-D')
+    expect(downloadTasksCsv).not.toHaveBeenCalled()
+
+    await userEvent.click(getByRole('button', { name: 'Clear filter' }))
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-D' }))
+      .toBeChecked()
+    await expect
+      .element(getByRole('button', { name: 'Export tasks', exact: true }))
+      .toBeInTheDocument()
+  })
+
+  it('keeps selections after a download failure so the same tasks can be retried', async () => {
+    vi.mocked(downloadTasksCsv).mockImplementationOnce(() => {
+      throw new Error('Download unavailable')
+    })
+    const { getByRole, getByTestId } = await render(<TableHarness />)
+
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-Z' }))
+    await userEvent.click(getByRole('button', { name: 'Next page' }))
+    await userEvent.click(getByRole('checkbox', { name: 'Select TASK-A' }))
+    await userEvent.click(
+      getByRole('button', { name: 'Export tasks', exact: true })
+    )
+
+    expect(downloadTasksCsv).toHaveBeenCalledExactlyOnceWith([
+      tasks[0],
+      tasks[2],
+    ])
+    expect(toast.error).toHaveBeenCalledOnce()
+    expect(toast.success).not.toHaveBeenCalled()
+    await expect
+      .element(getByTestId('selected-task-ids'))
+      .toHaveTextContent('TASK-A, TASK-Z')
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-A' }))
+      .toBeChecked()
+    await userEvent.click(getByRole('button', { name: 'Previous page' }))
+    await expect
+      .element(getByRole('checkbox', { name: 'Select TASK-Z' }))
+      .toBeChecked()
+
+    await userEvent.click(
+      getByRole('button', { name: 'Export tasks', exact: true })
+    )
+
+    expect(downloadTasksCsv).toHaveBeenCalledTimes(2)
+    expect(downloadTasksCsv).toHaveBeenNthCalledWith(2, [tasks[0], tasks[2]])
+    expect(toast.success).toHaveBeenCalledOnce()
+    expect(toast.error).toHaveBeenCalledOnce()
+    await expect
+      .element(getByTestId('selected-task-ids'))
+      .toHaveTextContent('TASK-A, TASK-Z')
+  })
+})
