+import Papa from 'papaparse'
+import { type Task } from '../data/schema'
+
+const columns = ['id', 'title', 'status', 'label', 'priority'] as const
+
+// Keep spreadsheet formula-like values as text, including multiline titles and
+// leading whitespace. The apostrophe is intentionally part of the CSV value.
+const formulaPrefix = /^[\t\r\n]|^\s*[=+\-@＝＋－＠]/
+
+export function createTasksCsv(tasks: readonly Task[]): string {
+  return (
+    '\ufeff' +
+    Papa.unparse(
+      {
+        fields: [...columns],
+        data: tasks.map((task) => columns.map((column) => task[column])),
+      },
+      { quotes: true, newline: '\r\n', escapeFormulae: formulaPrefix }
+    )
+  )
+}
+
+export function downloadTasksCsv(tasks: readonly Task[]): void {
+  if (tasks.length === 0) return
+
+  const blob = new Blob([createTasksCsv(tasks)], {
+    type: 'text/csv;charset=utf-8',
+  })
+  const url = URL.createObjectURL(blob)
+  let link: HTMLAnchorElement | undefined
+  let downloadStarted = false
+
+  try {
+    link = document.createElement('a')
+    link.href = url
+    link.download = `tasks-${new Date().toISOString().replace(/[:.]/g, '-')}.csv`
+    link.hidden = true
+    document.body.appendChild(link)
+    link.click()
+    downloadStarted = true
+  } finally {
+    link?.remove()
+    if (downloadStarted) {
+      // Give the browser time to consume the URL before releasing the Blob.
+      // A click starts a download; it cannot confirm the user saved the file.
+      setTimeout(() => URL.revokeObjectURL(url), 1000)
+    } else {
+      URL.revokeObjectURL(url)
+    }
+  }
+}
