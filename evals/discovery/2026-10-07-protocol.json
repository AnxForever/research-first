              ]
            },
            {
              "query": "其他",
              "delay_ms": 250,
              "outcome": "catalog entries containing the trimmed query"
            }
          ]
        },
        "existing_behavior": [
          "搜索通过表单提交，可用搜索按钮或 Enter。",
          "每次提交各自等待 localSearch 完成并直接写回结果，因此先提交的慢请求可能晚于后提交的快请求覆盖页面。",
          "空数组和 Promise reject 当前都显示‘没有找到结果’，无法区分无匹配和服务不可用。"
        ]
      },
      "review_checks": [
        {
          "id": "latest-submission-wins",
          "sequence": [
            "提交‘慢’。",
            "在该请求仍未完成时，将关键词改为‘快’并再次提交。",
            "先确认快查询的结果可见，再等到慢查询也已完成。"
          ],
          "expected": [
            "快查询完成后，当前结果对应‘快’并显示‘快速指南’。",
            "慢查询完成后，当前结果仍对应最后提交的‘快’；‘慢速连接说明’不能作为当前结果出现。",
            "界面给出的完成状态与当前可见结果一致。"
          ]
        },
        {
          "id": "empty-is-not-failure",
          "sequence": [
            "提交‘空’，等待查询完成。"
          ],
          "expected": [
            "界面明确表达当前查询没有匹配内容。",
            "界面不把此状态表达成暂时不可用或查询失败。",
            "当前查询的结果集合为空；若保留历史条目，必须清楚标明它们不属于当前查询。"
          ]
        },
        {
          "id": "temporary-failure-and-recovery",
          "sequence": [
            "首次提交‘暂时失败’，等待本地 API reject。",
            "再次提交同一关键词，等待本地 API resolve。"
          ],
          "expected": [
            "首次请求后，界面表达查询暂时不可用或失败，不能把它说成没有匹配内容。",
            "同一关键词再次提交后，界面从错误状态恢复，显示‘连接恢复手册’作为当前结果。",
            "恢复后的完成状态与可见结果一致，不再保留会误导用户的失败状态。"
          ]
        },
        {
          "id": "basic-use",
          "sequence": [
