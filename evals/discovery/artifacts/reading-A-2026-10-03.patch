+function refreshUndoButton() {
+  undoButton.hidden = localStorage.getItem(RECOVERY_KEY) === null;
+}
+
+function takeSnapshot() {
+  if (items.length === 0) return;
+  localStorage.setItem(RECOVERY_KEY, JSON.stringify({ savedAt: new Date().toISOString(), items }));
+  refreshUndoButton();
+}
+
+function exportBackup() {
+  const payload = { format: BACKUP_FORMAT, version: 1, exportedAt: new Date().toISOString(), items };
+  const url = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `稍后阅读-备份-${new Date().toISOString().slice(0, 10)}.json`;
+  document.body.append(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+  status.textContent = `已导出 ${items.length} 条备份。`;
+}
+
+function parseBackup(text) {
+  let data;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    return { error: '文件不是有效的 JSON。' };
+  }
+  let rawItems;
+  if (Array.isArray(data)) {
+    rawItems = data;
+  } else if (!data || typeof data !== 'object') {
+    return { error: '文件内容不是列表数据。' };
+  } else if (data.format !== BACKUP_FORMAT) {
+    return { error: '这不是本应用导出的备份文件。' };
+  } else if (data.version !== 1) {
+    return { error: '备份文件的版本无法识别。' };
+  } else {
+    rawItems = data.items;
+  }
+  if (!Array.isArray(rawItems)) return { error: '文件里没有找到列表数据。' };
+
+  const restored = [];
+  for (const [index, raw] of rawItems.entries()) {
+    const at = `第 ${index + 1} 条`;
+    if (!raw || typeof raw !== 'object') return { error: `${at}不是有效的条目。` };
+    const title = typeof raw.title === 'string' ? raw.title.trim() : '';
+    const url = typeof raw.url === 'string' ? raw.url.trim() : '';
+    if (!title) return { error: `${at}缺少标题。` };
+    let parsed;
+    try {
+      parsed = new URL(url);
+    } catch {
+      return { error: `${at}的网址无法识别。` };
+    }
+    // Only http/https links are rendered as clickable anchors.
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+      return { error: `${at}的网址不是 http/https，已停止恢复。` };
+    }
+    restored.push({
+      id: typeof raw.id === 'string' && raw.id ? raw.id : crypto.randomUUID(),
+      title,
+      url,
+      note: typeof raw.note === 'string' ? raw.note : '',
+      status: STATUSES.includes(raw.status) ? raw.status : 'unread',
+    });
+  }
+  return { items: restored };
+}
+
