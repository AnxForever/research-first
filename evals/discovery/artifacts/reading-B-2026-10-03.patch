+// 只接受 http/https：备份文件可能来自别人，javascript: 之类的地址点击后会执行脚本。
+function isSafeUrl(value) {
+  try {
+    const parsed = new URL(value);
+    return parsed.protocol === 'http:' || parsed.protocol === 'https:';
+  } catch {
+    return false;
+  }
+}
+
+// 把任意来源的数组整理成可信的条目，并报告被丢弃的数量。
+function normalizeItems(rawList) {
+  const result = [];
+  let skipped = 0;
+  for (const raw of rawList) {
+    if (!raw || typeof raw !== 'object') {
+      skipped++;
+      continue;
+    }
+    const title = typeof raw.title === 'string' ? raw.title.trim() : '';
+    const url = typeof raw.url === 'string' ? raw.url.trim() : '';
+    if (!title || !isSafeUrl(url)) {
+      skipped++;
+      continue;
+    }
+    result.push({
+      id: typeof raw.id === 'string' && raw.id ? raw.id : crypto.randomUUID(),
+      title,
+      url,
+      note: typeof raw.note === 'string' ? raw.note : '',
+      status: ALLOWED_STATUS.includes(raw.status) ? raw.status : 'unread',
+    });
+  }
+  return { items: result, skipped };
+}
 
