+      for (const key of Object.keys(HEADER_ALIASES)) {
+        const rank = HEADER_ALIASES[key].indexOf(normalized);
+        // When a file carries several aliases of one field (e.g. 名字 + 姓名), keep the
+        // most canonical one instead of whichever happens to come first.
+        if (rank >= 0 && (columns[key] === undefined || rank < ranks[key])) {
+          columns[key] = index;
+          ranks[key] = rank;
+        }
+      }
+    });
