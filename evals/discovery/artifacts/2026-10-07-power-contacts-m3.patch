+  // RFC 4180 tokenizer: quoted fields, doubled quotes, and line breaks inside quotes.
+  // Returns { records: [{ fields, line }] } or { error } for a structurally broken file.
+  function parseCsv(text) {
+    const records = [];
+    let fields = [];
+    let field = '';
+    let inQuotes = false;
+    let line = 1;
+    let recordLine = 1;
+    for (let i = 0; i < text.length; i++) {
+      const ch = text[i];
+      if (inQuotes) {
+        if (ch === '"') {
+          if (text[i + 1] === '"') { field += '"'; i++; }
+          else inQuotes = false;
+        } else if (ch === '\r' && text[i + 1] === '\n') {
+          field += '\n'; line++; i++;
+        } else if (ch === '\n') {
+          field += '\n'; line++;
+        } else {
+          field += ch;
+        }
+        continue;
+      }
+      if (ch === '"' && field === '') { inQuotes = true; continue; }
+      if (ch === ',') { fields.push(field); field = ''; continue; }
+      if (ch === '\n' || ch === '\r') {
+        fields.push(field);
+        records.push({ fields, line: recordLine });
+        fields = [];
+        field = '';
+        if (ch === '\r' && text[i + 1] === '\n') i++;
+        line++;
+        recordLine = line;
+        continue;
+      }
+      field += ch;
+    }
+    if (inQuotes) return { error: `第 ${recordLine} 行开始的引号没有闭合，无法解析该文件。` };
+    if (field !== '' || fields.length > 0) {
+      fields.push(field);
+      records.push({ fields, line: recordLine });
+    }
+    return { records };
+  }
