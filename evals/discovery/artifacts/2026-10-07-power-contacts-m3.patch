+      return { error: `表头缺少必需的列：${missing.join('、')}；读到的表头是：${seen}。` };
+    }
+
+    const known = new Set(contacts.map((c) => c.email.trim().toLowerCase()));
+    const imported = [];
+    const skipped = [];
+    let blank = 0;
+
+    for (let i = headerAt + 1; i < records.length; i++) {
+      const { fields, line } = records[i];
+      if (fields.every((f) => f.trim() === '')) { blank++; continue; }
+      if (fields.length > header.length) { skipped.push({ line, reason: '列数多于表头' }); continue; }
+
+      const value = (key) => (columns[key] === undefined ? '' : (fields[columns[key]] ?? '').trim());
+      const name = value('name');
+      const email = value('email');
+      if (!name && !email) { skipped.push({ line, reason: '缺少姓名和邮箱' }); continue; }
+      if (!name) { skipped.push({ line, reason: '缺少姓名' }); continue; }
+      if (!email) { skipped.push({ line, reason: '缺少邮箱' }); continue; }
