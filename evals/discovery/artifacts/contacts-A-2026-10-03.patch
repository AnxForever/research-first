+      return;
+    }
+
+    const details = [...plan.notes];
+    if (decoded.note) details.push(decoded.note);
+    if (plan.unknown.length > 0) details.push(`已忽略未识别的列：${plan.unknown.join('、')}`);
+
+    const listed = plan.errors.slice(0, MAX_LISTED_ERRORS);
+    for (const error of listed) details.push(`第 ${error.line} 行：${error.message}`);
+    if (plan.errors.length > listed.length) {
+      details.push(`……另外还有 ${plan.errors.length - listed.length} 行有同样的问题。`);
