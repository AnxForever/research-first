+  // ==== CSV 核心：纯函数，不接触 DOM，便于单独测试 ====
+
+  const COLUMN_ALIASES = {
+    name: ['姓名', '名字', '联系人', 'name', 'fullname', 'contact'],
+    email: ['邮箱', '电子邮箱', '电子邮件', '邮件', 'email', 'mail', 'emailaddress'],
+    company: ['公司', '单位', '机构', '组织', 'company', 'organization', 'organisation', 'org'],
+  };
+
+  function normalizeLabel(value) {
+    return String(value).trim().toLowerCase().replace(/[\s\-_]+/g, '');
+  }
+
+  const NORMALIZED_ALIASES = Object.fromEntries(
+    Object.entries(COLUMN_ALIASES).map(([field, labels]) => [field, labels.map(normalizeLabel)])
+  );
+
+  // 按 RFC 4180 解析：引号包裹的逗号与换行、双写引号转义、CRLF/CR/LF、末尾换行
+  // 不产生空记录。引号只在字段开头才有特殊含义，字段中间的引号按字面处理。
+  function parseCsvRows(text) {
+    const rows = [];
+    let cells = [];
+    let field = '';
+    let fieldStart = true;
+    let inQuotes = false;
+    let line = 1;
+    let rowLine = 1;
+    let i = 0;
+
+    const endField = () => { cells.push(field); field = ''; fieldStart = true; };
+    const endRow = () => { endField(); rows.push({ cells, line: rowLine }); cells = []; };
+
+    while (i < text.length) {
+      const ch = text[i];
+
+      if (inQuotes) {
+        if (ch === '"') {
+          if (text[i + 1] === '"') { field += '"'; i += 2; continue; }
+          inQuotes = false; i += 1; continue;
+        }
+        if (ch === '\n') line += 1;
+        field += ch; i += 1; continue;
+      }
+
+      if (ch === '"' && fieldStart) { inQuotes = true; fieldStart = false; i += 1; continue; }
+      if (ch === ',') { endField(); i += 1; continue; }
+      if (ch === '\r' || ch === '\n') {
+        if (ch === '\r' && text[i + 1] === '\n') i += 1;
+        i += 1;
+        endRow();
+        line += 1;
+        rowLine = line;
+        continue;
+      }
+
+      field += ch;
+      fieldStart = false;
+      i += 1;
+    }
+
+    const unterminatedQuote = inQuotes;
+    if (field !== '' || cells.length > 0) { endField(); rows.push({ cells, line: rowLine }); }
+    return { rows, unterminatedQuote };
+  }
+
+  // 字节 → 文本。Excel 在中文 Windows 上默认导出 GBK，而 Blob.text() 只认 UTF-8，
+  // 直接用它会把中文读成乱码，所以先按 UTF-8 严格解码，失败再退回 GB18030。
+  function decodeCsvBytes(buffer) {
+    const bytes = new Uint8Array(buffer);
+    const decode = (label, fatal) => new TextDecoder(label, { fatal }).decode(bytes);
+
+    try {
+      return { text: decode('utf-8', true).replace(/^﻿/, ''), encoding: 'UTF-8', note: '' };
+    } catch (error) {
+      // 不是合法的 UTF-8，继续尝试中文编码。
+    }
+
+    try {
+      return {
+        text: decode('gb18030', true),
+        encoding: 'GB18030',
+        note: '这个文件不是 UTF-8，已按 GB18030/GBK 解读。若出现乱码，请在 Excel 里另存为「CSV UTF-8」再导入。',
+      };
+    } catch (error) {
+      // 某些浏览器（如部分 Safari）不提供 gb18030 解码器。
+    }
+
+    return {
+      text: new TextDecoder('utf-8').decode(bytes).replace(/^﻿/, ''),
+      encoding: 'UTF-8（容错）',
+      note: '无法确定这个文件的编码，已按 UTF-8 尽力解读，个别字符可能显示为乱码。',
+    };
+  }
+
+  function mapHeaderRow(headerCells) {
+    const labels = headerCells.map(normalizeLabel);
+    const mapping = {};
+    for (const [field, aliases] of Object.entries(NORMALIZED_ALIASES)) {
+      const index = labels.findIndex((label) => aliases.includes(label));
+      if (index !== -1) mapping[field] = index;
+    }
+    const mappedIndexes = Object.values(mapping);
+    const missing = ['name', 'email'].filter((field) => !(field in mapping));
+    const unknown = headerCells
+      .map((cell, index) => (cell.trim() !== '' && !mappedIndexes.includes(index) ? cell.trim() : ''))
+      .filter(Boolean);
+    return { mapping, missing, unknown };
+  }
+
+  const EMAIL_PATTERN = /^[^\s@,;]+@[^\s@,;]+\.[^\s@,;]+$/;
+
+  function contactKey(contact) {
+    return [contact.name, contact.email.toLowerCase(), contact.company].join('\u0000');
+  }
+
+  // 纯函数：算出「会新增什么、跳过什么、哪几行有问题」，不改动 existing。
+  function buildImportPlan(existing, text) {
+    const { rows, unterminatedQuote } = parseCsvRows(text);
+    const notes = [];
+    if (unterminatedQuote) notes.push('文件里有未闭合的引号，解析结果可能不完整，建议检查这个文件。');
+
+    const empty = { fatal: '', notes, toAdd: [], duplicates: 0, errors: [], unknown: [] };
+    const dataRows = rows.filter((row) => row.cells.some((cell) => cell.trim() !== ''));
+
+    if (dataRows.length === 0) {
+      return { ...empty, fatal: '文件里没有可读取的内容。' };
+    }
+
+    const header = dataRows[0];
+    const { mapping, missing, unknown } = mapHeaderRow(header.cells);
+
+    if (missing.length > 0) {
+      const names = missing.map((field) => (field === 'name' ? '「姓名」' : '「邮箱」')).join('和');
+      return {
+        ...empty,
+        fatal: `第一行表头里没有找到${names}列。请让表头包含 姓名、邮箱、公司，或对应的 name / email / company。`,
+      };
+    }
+
+    const headerWidth = header.cells.length;
+    const seen = new Set(existing.map(contactKey));
+    const toAdd = [];
+    const errors = [];
+    let duplicates = 0;
+
+    for (const row of dataRows.slice(1)) {
+      const raw = row.cells.map((cell) => cell.trim());
+
+      // 列数比表头多，最可能是某个字段里的逗号没有用引号包起来，
+      // 此时按列号取值会取错，所以整行跳过而不是猜。
+      if (raw.length > headerWidth) {
+        errors.push({
+          line: row.line,
+          message: `这一行有 ${raw.length} 列，多于表头的 ${headerWidth} 列，可能有逗号没有用引号包起来。`,
+        });
+        continue;
+      }
+
+      const pick = (field) => (field in mapping ? raw[mapping[field]] ?? '' : '');
+      const contact = { name: pick('name'), email: pick('email'), company: pick('company') };
+
+      if (!contact.name) { errors.push({ line: row.line, message: '缺少姓名。' }); continue; }
+      if (!contact.email) { errors.push({ line: row.line, message: '缺少邮箱。' }); continue; }
+      if (!EMAIL_PATTERN.test(contact.email)) {
+        errors.push({ line: row.line, message: `邮箱格式不正确：${contact.email}` });
+        continue;
+      }
+
+      const key = contactKey(contact);
+      if (seen.has(key)) { duplicates += 1; continue; }
+      seen.add(key);
+      toAdd.push(contact);
+    }
+
+    return { fatal: '', notes, toAdd, duplicates, errors, unknown };
+  }
+
+  // ==== CSV 核心结束 ====
+
+  const dropZone = document.getElementById('dropZone');
+  const fileInput = document.getElementById('csvFile');
+  const statusBox = document.getElementById('importStatus');
+  const MAX_LISTED_ERRORS = 20;
+  let undoSnapshot = null;
+
+  // 全部用 textContent 写入：CSV 内容属于外部输入，不能当成 HTML 解析。
+  function showStatus(kind, summary, details, onUndo) {
+    statusBox.className = `status is-${kind}`;
+    statusBox.hidden = false;
+    statusBox.replaceChildren();
+
+    const lead = document.createElement('p');
+    lead.textContent = summary;
