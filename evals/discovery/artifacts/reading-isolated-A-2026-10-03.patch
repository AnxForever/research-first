+// A single "previous list" slot. Written just before anything replaces the list,
+// so an accidental 清空 or 恢复 can be walked back.
+function readSnapshot() {
+  const raw = localStorage.getItem(SNAPSHOT_KEY);
+  if (raw === null) return null;
+  try {
+    const saved = JSON.parse(raw);
+    return saved && Array.isArray(saved.items) ? saved : null;
+  } catch {
+    return null;
+  }
+}
+
+function writeSnapshot(reason) {
+  localStorage.setItem(SNAPSHOT_KEY, JSON.stringify({ reason, at: new Date().toISOString(), items }));
+  updateUndoButton();
+}
+
+function clearSnapshot() {
+  localStorage.removeItem(SNAPSHOT_KEY);
+  updateUndoButton();
+}
+
+function updateUndoButton() {
+  const snapshot = readSnapshot();
+  undoButton.hidden = snapshot === null;
+  undoButton.textContent = snapshot ? `撤销上次${snapshot.reason}` : '撤销';
+}
+
+function backupPayload() {
+  return JSON.stringify({ app: 'reading-list', version: 1, exportedAt: new Date().toISOString(), items }, null, 2);
+}
+
+// Turns parsed backup data into a clean item list. Throws before anything is
+// written, so a bad file can never leave the current list half-replaced.
+function itemsFromBackup(parsed) {
+  const list = Array.isArray(parsed) ? parsed : parsed && Array.isArray(parsed.items) ? parsed.items : null;
+  if (list === null) {
+    throw new Error('文件里没有列表数据，可能不是这个应用的备份');
+  }
+  return list.map(entry => {
+    if (!entry || typeof entry !== 'object' || typeof entry.url !== 'string' || entry.url.trim() === '') {
+      throw new Error('备份里有条目缺少网址，已停止恢复');
+    }
+    return {
+      id: typeof entry.id === 'string' && entry.id ? entry.id : crypto.randomUUID(),
+      title: typeof entry.title === 'string' && entry.title.trim() ? entry.title : entry.url,
+      url: entry.url,
+      note: typeof entry.note === 'string' ? entry.note : '',
+      status: typeof entry.status === 'string' && entry.status ? entry.status : 'unread',
+    };
+  });
+}
+
+function finishRestore() {
+  const next = pendingRestore;
+  pendingRestore = null;
+  if (next === null) return;
+  writeSnapshot('恢复');
+  items = next;
+  saveItems();
+  renderItems();
+  status.textContent = `已从备份恢复 ${items.length} 条。恢复前的列表可以用“撤销上次恢复”找回。`;
+}
