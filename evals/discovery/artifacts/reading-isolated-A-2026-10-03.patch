+
+fileInput.addEventListener('change', async () => {
+  const file = fileInput.files[0];
+  fileInput.value = '';
+  if (!file) return;
+
+  let next;
+  try {
+    const raw = await file.text();
+    // Notepad and Excel on Windows prepend a BOM; JSON.parse chokes on it.
+    const text = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
+    let parsed;
+    try {
+      parsed = JSON.parse(text);
+    } catch {
+      throw new Error('文件内容不是有效的 JSON');
+    }
+    next = itemsFromBackup(parsed);
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : '这个文件读不出来';
+    status.textContent = `恢复失败：${reason}。当前列表没有改动。`;
+    return;
+  }
+
+  pendingRestore = next;
+  if (items.length === 0) {
+    finishRestore();
+    return;
+  }
+  restoreDesc.textContent =
+    `备份里有 ${next.length} 条，当前列表有 ${items.length} 条。` +
+    `继续会用备份替换当前列表；恢复前的列表会留一份快照，之后可以撤销。`;
+  restoreDialog.showModal();
+});
+
+// finishRestore() clears pendingRestore before close() so the dialog's close
+// handler stays quiet, whichever order the browser fires things in.
+document.querySelector('#restore-confirm').addEventListener('click', () => {
+  finishRestore();
+  restoreDialog.close();
+});
+
+document.querySelector('#restore-cancel').addEventListener('click', () => {
+  restoreDialog.close();
+});
+
+// Esc (native cancel) and the 取消 button both land here, so backing out never
+// leaves a half-applied restore waiting. Clicking the backdrop does not close.
+// Focus goes to the visible trigger rather than the offscreen file input.
+restoreDialog.addEventListener('close', () => {
+  if (pendingRestore !== null) {
+    pendingRestore = null;
+    status.textContent = '已取消恢复，当前列表没有改动。';
+  }
+  importButton.focus();
+});
+
+undoButton.addEventListener('click', () => {
+  const snapshot = readSnapshot();
+  if (snapshot === null) return;
+  items = snapshot.items;
+  saveItems();
+  renderItems();
+  clearSnapshot();
+  status.textContent = `已撤销上次${snapshot.reason}，找回 ${items.length} 条。`;
+});
+
+updateUndoButton();
 renderItems();
