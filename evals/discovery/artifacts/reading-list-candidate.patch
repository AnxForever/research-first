+/* ---------- 备份与恢复 ---------- */
+
+function backupFileName(date = new Date()) {
+  const pad = value => String(value).padStart(2, '0');
+  return `reading-list-backup-${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}.json`;
+}
+
+function serializeBackup() {
+  return JSON.stringify(
+    { app: BACKUP_MARK, version: BACKUP_VERSION, exportedAt: new Date().toISOString(), items },
+    null,
+    2,
+  );
+}
+
+// 下载只是顺手提供的便利：file:// 等环境下浏览器可能忽略 download 属性，
+// 所以真正可靠的备份途径是旁边的文本框。
+function downloadBackup(text) {
+  try {
+    const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = backupFileName();
+    link.hidden = true;
+    document.body.append(link);
+    link.click();
+    link.remove();
+    // 稍后再释放，避免部分浏览器还没开始下载链接就失效。
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  } catch {
+    /* 忽略：用户可以改用文本框复制。 */
+  }
+}
+
+// 只接受 http/https，避免从别人的备份文件里带进 javascript: 之类的地址。
+function toHttpUrl(value) {
+  try {
+    const url = new URL(value);
+    return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+// 校验整份备份；任何一条不合格就整份拒绝，绝不写坏当前列表。
+function parseBackup(text) {
+  let data;
+  try {
+    data = JSON.parse(text);
+  } catch {
+    throw new Error('内容不是有效的 JSON。');
+  }
+
+  // 接受带说明的备份文件，也接受 localStorage 里那种纯数组。
+  const list = Array.isArray(data) ? data : Array.isArray(data?.items) ? data.items : null;
+  if (list === null) throw new Error('这不像本应用的备份（找不到条目列表）。');
+
+  const usedIds = new Set();
+  return list.map((raw, index) => {
+    const at = `第 ${index + 1} 条`;
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error(`${at}不是有效的条目。`);
+
+    const title = typeof raw.title === 'string' ? raw.title.trim() : '';
+    if (!title) throw new Error(`${at}缺少标题。`);
+
+    const url = typeof raw.url === 'string' ? toHttpUrl(raw.url.trim()) : null;
+    if (!url) throw new Error(`${at}的网址不是有效的 http/https 地址。`);
+
+    const id = typeof raw.id === 'string' && raw.id && !usedIds.has(raw.id) ? raw.id : crypto.randomUUID();
+    usedIds.add(id);
+
+    return {
+      id,
+      title,
+      url,
+      note: typeof raw.note === 'string' ? raw.note : '',
+      status: VALID_STATUSES.includes(raw.status) ? raw.status : 'unread',
+    };
+  });
+}
+
+// 比较用户能看到的内容，忽略 id：id 不同但内容相同，恢复后列表没有变化。
+function sameContent(a, b) {
+  const key = list => list.map(item => [item.title, item.url, item.note, item.status].join('\u0000')).join('\u0001');
+  return key(a) === key(b);
+}
+
+function applyRestore(incoming) {
+  items = incoming;
+  saveItems();
+  renderItems();
+}
+
+function requestRestore(text, trigger) {
+  let incoming;
+  try {
+    incoming = parseBackup(text);
+  } catch (error) {
+    status.textContent = `无法恢复：${error.message}`;
+    return;
+  }
+
+  if (sameContent(incoming, items)) {
+    status.textContent = `备份内容与当前列表一致（${items.length} 条），没有改动。`;
+    return;
+  }
+
+  // 只有当前列表真的会被覆盖时才拦一下确认。
+  if (items.length === 0) {
+    applyRestore(incoming);
+    status.textContent = `已恢复 ${incoming.length} 条。`;
+    return;
+  }
+
+  pendingRestore = incoming;
+  restoreTrigger = trigger;
+  restoreDetail.textContent =
+    `当前列表有 ${items.length} 条，备份有 ${incoming.length} 条。继续会用备份替换当前列表，现在的 ${items.length} 条将被丢弃。`;
+  restoreDialog.showModal();
+}
+
+function closeRestoreDialog(message) {
+  pendingRestore = null;
+  restoreDialog.close();
+  if (message) status.textContent = message;
+  const trigger = restoreTrigger;
+  restoreTrigger = null;
+  if (trigger) trigger.focus();
 }
 
