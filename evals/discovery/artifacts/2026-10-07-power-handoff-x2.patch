+def render_export(items):
+    """Render the checked rows as a Markdown reading list, in stored order."""
+    lines = []
+    for item in items:
+        label = render_markdown_link(item.get("title", ""), item.get("url", ""))
+        note = flatten_note(item.get("note", ""))
+        lines.append("- {}{}".format(label, " — {}".format(note) if note else ""))
+    if not lines:
+        return "# 阅读清单\n"
+    return "# 阅读清单\n\n{}\n".format("\n".join(lines))
+
+
+def check_flags(items, data_path):
+    """A row may omit `selected`, but an unreadable value is never guessed at."""
+    for item in items:
+        value = item.get("selected")
+        if value is not None and not isinstance(value, bool):
+            print(
+                "error: {}: item {!r} has a non-boolean selected value {!r}".format(
+                    data_path, item.get("id", "?"), value
+                ),
+                file=sys.stderr,
+            )
+            return False
+    return True
+
+
+def export_selected(items, output_path, data_path):
+    """Write the checked rows to a file; the shelf data itself is never written."""
+    if output_path.resolve() == data_path.resolve():
+        print(
+            "error: refusing to overwrite the shelf data file: {}".format(output_path),
+            file=sys.stderr,
+        )
+        return 1
+    if not check_flags(items, data_path):
+        print("error: nothing written; fix the data and run export again", file=sys.stderr)
+        return 1
+    chosen = selected_items(items)
+    for item in chosen:
+        if not str(item.get("url", "")).strip():
+            print(
+                "warning: item {!r} is checked but has no url".format(item.get("id", "?")),
+                file=sys.stderr,
+            )
+    if output_path.exists():
+        print("overwriting existing file: {}".format(output_path), file=sys.stderr)
+    try:
+        output_path.write_text(render_export(chosen), encoding="utf-8", newline="\n")
+    except OSError as error:
+        print("error: cannot write {}: {}".format(output_path, error), file=sys.stderr)
+        return 1
+    if not chosen:
+        print("warning: no item is checked, wrote an empty list", file=sys.stderr)
+    print("exported {} item(s) to {}".format(len(chosen), output_path))
+    return 0
+
+
