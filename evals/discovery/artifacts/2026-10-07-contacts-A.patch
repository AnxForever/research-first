+  fileInput.addEventListener('change', async (event) => {
+    const file = event.target.files[0];
+    event.target.value = ''; // let the same file be picked again
+    if (!file) return;
+    try {
+      await importCsvFile(file);
+    } catch (error) {
+      report(`导入失败：${error.message}。现有联系人未改动。`, true);
+    }
+  });
+
   renderContacts();
